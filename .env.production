# Loaded automatically by `vite build`.
#
# VITE_API_URL is deliberately UNSET here: API_BASE then falls back to the
# relative path "/api/v1", which vercel.json rewrites straight through to
# the Render backend. That makes every API call same-origin from the
# browser's point of view, so the session cookie is a first-party cookie —
# not a third-party one that Safari's ITP and a growing share of Chrome/
# Firefox users block outright regardless of its SameSite/Secure attributes.
# (If you ever need to point the SPA directly at the API again — e.g. to
# rule out the proxy while debugging — set VITE_API_URL here and it wins.)
#
# Sockets can't ride that HTTP-only rewrite, so they get their own explicit
# absolute origin instead.
VITE_SOCKET_URL=https://businessai-backend-6g8l.onrender.com
