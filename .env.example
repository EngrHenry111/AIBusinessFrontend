# Copy to .env for local development (optional — without it the Vite proxy
# forwards /api to http://localhost:5000).
#
# VITE_API_URL is the backend ORIGIN only. Do NOT append /api/v1 — the app adds it.
VITE_API_URL=https://businessai-backend-6g8l.onrender.com

# Google OAuth client id (enables the "Continue with Google" button)
VITE_GOOGLE_CLIENT_ID=

# Set to any value to log the resolved API base URL in the browser console
VITE_DEBUG_API=
